{
  "name": "santtu-nurmi-portfolio",
  "version": "3.0.0",
  "private": true,
  "description": "Portfolio website",
  "author": "Santtu Nurmi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santtunurmi/santtunurmi.github.io.git"
  },
  "homepage": "https://santtunurmi.netlify.app/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "legacy:js-compile": "esbuild index.js --bundle --outfile=./docs/javascript/bundle.js",
    "legacy:css-compile": "sass ./scss/main.scss ./docs/css/stylesheet.css",
    "legacy:css-prefix": "postcss --replace docs/css/stylesheet.css --use autoprefixer --map",
    "legacy:build": "npm run legacy:css-compile && npm run legacy:css-prefix && npm run legacy:js-compile"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "jquery": "^3.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "esbuild": "0.27.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
